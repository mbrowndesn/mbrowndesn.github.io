
<div
  id="gallery-lightbox"
  class="lightbox fixed inset-0 z-[1000] hidden items-center justify-between gap-3 bg-[var(--background)] p-6 text-[var(--text)] max-[600px]:gap-0 max-[600px]:p-3 [&.active]:flex"
  role="dialog"
  aria-modal="true"
  aria-label="Image gallery"
  aria-hidden="true"
>

<button
  class="close absolute right-5 top-3 cursor-pointer border-0 bg-transparent p-3 text-[36px] text-[var(--text)] hover:text-[var(--accent)] max-[600px]:p-1.5 max-[600px]:text-[28px]"
  aria-label="Close image"
>×</button>

<button
  class="previous cursor-pointer border-0 bg-transparent p-3 text-[36px] text-[var(--text)] hover:text-[var(--accent)] max-[600px]:p-1.5 max-[600px]:text-[28px]"
  aria-label="Previous image"
>‹</button>



<figure class="m-0 min-w-0 flex-1 text-center">
  <img
    id="lightbox-image"
    src=""
    alt=""
    class="mx-auto block h-auto max-h-[75vh] w-auto max-w-full object-contain"
  />

  <figcaption class="mt-4">
    <h2 id="lightbox-title" class="m-0 text-[1.1rem]"></h2>
    <p id="lightbox-date" class="mt-1.5 text-[0.9rem]"></p>
  </figcaption>
</figure>



<button
  class="next cursor-pointer border-0 bg-transparent p-3 text-[36px] text-[var(--text)] hover:text-[var(--accent)] max-[600px]:p-1.5 max-[600px]:text-[28px]"
  aria-label="Next image"
>›</button>

</div>

<script>
  const lightbox = document.querySelector<HTMLElement>('#gallery-lightbox');
  const image = document.querySelector<HTMLImageElement>('#lightbox-image');
  const title = document.querySelector<HTMLElement>('#lightbox-title');
  const date = document.querySelector<HTMLElement>('#lightbox-date');

  let currentIndex = 0;
  let items: HTMLElement[] = [];
  let previousFocus: HTMLElement | null = null;

  function showImage(index: number) {
    if (!image || !title || !date || !items.length) return;

    currentIndex = (index + items.length) % items.length;
    const item = items[currentIndex];

    image.src = item.dataset.image || '';
    image.alt = item.dataset.title || '';
    title.textContent = item.dataset.title || '';
    date.textContent = item.dataset.date || '';
  }

  function openLightbox(index: number) {
    if (!lightbox) return;

    previousFocus = document.activeElement as HTMLElement;
    showImage(index);
    lightbox.classList.add('active');
    lightbox.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
    lightbox.querySelector<HTMLButtonElement>('.close')?.focus();
  }

  function closeLightbox() {
    if (!lightbox) return;

    lightbox.classList.remove('active');
    lightbox.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
    previousFocus?.focus();
  }

  items = [...document.querySelectorAll<HTMLElement>('.gallery-item')];

  items.forEach((item, index) => {
    item.addEventListener('click', () => openLightbox(index));
  });

  lightbox?.querySelector('.close')?.addEventListener('click', closeLightbox);
  lightbox?.querySelector('.previous')?.addEventListener('click', () => showImage(currentIndex - 1));
  lightbox?.querySelector('.next')?.addEventListener('click', () => showImage(currentIndex + 1));

  document.addEventListener('keydown', (event) => {
    if (!lightbox?.classList.contains('active')) return;

    if (event.key === 'Escape') closeLightbox();
    if (event.key === 'ArrowLeft') showImage(currentIndex - 1);
    if (event.key === 'ArrowRight') showImage(currentIndex + 1);
  });
</script>