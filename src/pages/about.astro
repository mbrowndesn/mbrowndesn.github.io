
---
import BaseLayout from '../layouts/BaseLayout.astro';
import { about } from '../data/site.js';
---

<BaseLayout title={about.pageTitle}>
  <main class="grid grid-cols-1 items-center gap-[30px] pt-[30px] md:grid-cols-2 md:gap-[8%] md:pt-[70px]">
    <div>
      <img
        src={about.image}
        alt={about.imageAlt}
        class="block h-[600px] w-full object-cover object-bottom"
      />
    </div>

    <section>
      <h1 class="mb-[30px] font-serif text-[clamp(3rem,6vw,5rem)]">
        {about.heading}
      </h1>

      {about.paragraphs.map((paragraph) => (
        <p class="max-w-[500px] leading-[1.8]">
          {paragraph}
        </p>
      ))}

      <div class="mt-[35px] flex gap-[30px]">
        {about.links.map((link) => (
          <a
            href={link.href}
            target={link.href.startsWith('http') ? '_blank' : undefined}
            rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
            class="text-[var(--accent)] no-underline hover:underline"
          >
            {link.label}
          </a>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
