
---
import BaseLayout from '../layouts/BaseLayout.astro';
import { home } from '../data/site.js';
---

<BaseLayout title={home.pageTitle}>
  <main class="mx-auto max-w-[1400px] px-6 py-[30px] md:px-[5%]">
    <section class="grid min-h-[70vh] grid-cols-1 items-center gap-10 md:grid-cols-[1fr_1.2fr] md:gap-[5%]">
      <div class="animate-[fadeUp_0.8s_ease_both] motion-reduce:animate-none">
        <p class="text-xs tracking-[0.2em] text-[var(--accent)]">
          {home.eyebrow}
        </p>

        <h1 class="my-6 font-serif text-[clamp(3.5rem,7vw,7rem)] leading-none tracking-[-0.05em]">
          {home.name}<span class="text-[var(--accent)]">.</span>
        </h1>

        <p class="text-base leading-[1.7]">
          {home.subtitle}
        </p>
      </div>

      <div class="w-full animate-[fadeUp_1s_ease_0.15s_both] motion-reduce:animate-none">
        <img
          src={home.image}
          alt={home.imageAlt}
          fetchpriority="high"
          class="block h-auto max-h-[70vh] w-full object-contain"
        />
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(15px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
