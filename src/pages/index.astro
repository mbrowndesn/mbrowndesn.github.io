
---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Home | My Digital Garden">
  <main class="home">
    <section class="hero">
      <div class="intro">
        <p class="eyebrow">DESIGNER • CREATIVE • EXPLORER</p>
        <h1>Macy Brown<span>.</span></h1>
        <p class="subtitle">Welcome to my little corner of the internet.</p>
      </div>

      <div class="hero-image">
        <img
          src="/homepage.jpg"
          alt="A favorite photograph"
          fetchpriority="high"
        />
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .home {
    max-width: 1400px;
    padding: 30px 5%;
  }

  .hero {
    min-height: 70vh;
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    align-items: center;
    gap: 5%;
  }

  .intro {
    animation: fadeUp 0.8s ease both;
  }

  .eyebrow {
    color: var(--accent);
    font-size: 0.75rem;
    letter-spacing: 0.2em;
  }

  h1 {
    font-family: Georgia, serif;
    font-size: clamp(3.5rem, 7vw, 7rem);
    line-height: 1;
    letter-spacing: -0.05em;
    margin: 24px 0;
  }

  h1 span {
    color: var(--accent);
  }

  .subtitle {
    font-size: 1rem;
    line-height: 1.7;
  }

  .hero-image {
    width: 100%;
    animation: fadeUp 1s ease 0.15s both;
  }

  img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 70vh;
    object-fit: contain;
  }

  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(15px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 768px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .home {
      padding: 30px 24px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .intro,
    .hero-image {
      animation: none;
    }
  }
</style>
