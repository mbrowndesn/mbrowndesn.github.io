
---
import BaseLayout from '../layouts/BaseLayout.astro';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';
import { notebookPage } from '../data/site.js';

const reader = createReader('.', keystaticConfig);

const entries = (await reader.collections.notebook.all())
  .map(({ entry }) => ({
    title: entry.title,
    image: entry.image,
    description: entry.description,
    content: entry.content,
    order: entry.order,
  }))
  .sort((a, b) => (a.order ?? 0) - (b.order ?? 0));
---

<BaseLayout title={notebookPage.pageTitle}>
  <main>
    <h1 class="mb-10 font-serif text-[clamp(3rem,6vw,5rem)]">
      {notebookPage.heading}
    </h1>

    <div class="grid grid-cols-1 items-start gap-6 min-[601px]:grid-cols-2 min-[901px]:grid-cols-3">
      {entries.map((entry) => (
        <details class="group min-w-0 border border-[var(--text)]">
          <summary class="cursor-pointer list-none [&::-webkit-details-marker]:hidden">
            <img
              src={entry.image}
              alt=""
              loading="lazy"
              class="block aspect-[4/3] w-full object-cover"
            />

            <div class="p-5">
              <h2 class="mb-3 font-serif text-[1.4rem]">
                {entry.title}
              </h2>

              <p class="text-[0.95rem] leading-[1.6]">
                {entry.description}
              </p>

              <span class="mt-[14px] inline-block text-[0.85rem] text-[var(--accent)] group-open:text-[var(--text)]">
                {notebookPage.expandLabel}
              </span>
            </div>
          </summary>

          <div class="border-t border-[var(--text)] px-5 pb-5">
            <p class="text-[0.95rem] leading-[1.6]">
              {entry.content}
            </p>
          </div>
        </details>
      ))}
    </div>
  </main>
</BaseLayout>
